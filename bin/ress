#!/bin/bash
#
# ress — capture an Omarchy machine, replay it onto a fresh one.
#
# This entrypoint and the modules it loads are the whole engine. The Quickshell
# panel is a face on top of the CLI; every button there invokes one of these
# subcommands with --porcelain. The CLI remains usable without a desktop.

set -euo pipefail


# ---------------------------------------------------------------- locations

self_dir() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L $src ]]; do
    local dir
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    [[ $src == /* ]] || src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

SELF_DIR=$(self_dir)
PLUGIN_DIR=$(dirname "$SELF_DIR")
RESS_MODULES=(
  lib/ress/core.sh
  lib/ress/safety.sh
  lib/ress/vault/common.sh
  lib/ress/vault/backup.sh
  lib/ress/vault/restore.sh
  lib/ress/vault/verify.sh
  lib/ress/vault/commands.sh
  lib/ress/loadout/registry.sh
  lib/ress/loadout/profile.sh
  lib/ress/loadout/resources.sh
  lib/ress/loadout/share.sh
  lib/ress/loadout/lifecycle.sh
  lib/ress/loadout/apply.sh
)
for module in "${RESS_MODULES[@]}"; do
  module_path="$PLUGIN_DIR/$module"
  if [[ ! -r $module_path ]]; then
    printf 'ress: required module is missing or unreadable: %s\n' "$module_path" >&2
    exit 1
  fi
  source "$module_path"
done
unset module module_path


trap ress_cleanup EXIT




# ==================================================================== USAGE

usage() {
  cat <<USAGE
${c_bold}ress${c_reset} $VERSION — capture an Omarchy machine, replay it onto a fresh one.

  ${c_bold}ress backup${c_reset} [-m MSG] [--push] [--secrets]
      Capture this machine into the vault and commit it.

  ${c_bold}ress restore${c_reset} [--from GIT_URL] [--only LIST] [--skip LIST] [--dry-run]
      Replay a vault onto this machine. Resumable; rerun to continue.
      Two things it will not do without being asked: build an AUR package
      (--aur, --no-aur, --review-aur) and enable a systemd user service
      (--enable-units, --no-enable-units). --yes does not answer either.

  ${c_bold}ress share${c_reset} [--name NAME] [--description TEXT] [--out DIR]
      Export a loadout: the package, plugin, web app and theme list, with
      nothing from your home directory. Push it and share the URL.
  ${c_bold}ress share catalog --json${c_reset} [--out DIR]
      Inspect candidates, current export and applied-loadout starting choices.
  ${c_bold}ress share --custom --select ID...${c_reset} [--name NAME] [--description TEXT]
      Export an exact non-empty subset. Repeat --acknowledge-unavailable ID
      FINGERPRINT for every unavailable item deliberately withdrawn.

  ${c_bold}ress apply${c_reset} <git-url> [--dry-run]
      Install someone else's loadout. Shows the full list and asks first.

  ${c_bold}ress loadout${c_reset} <list|show|check|repair|update|remove> ...
      Inspect and manage the loadouts tracked on this machine.
  ${c_bold}ress resource${c_reset} <list|show> ...
      Inspect loadout resource provenance, health and claimants.

  ${c_bold}ress verify${c_reset} [--json]      Check this machine against the vault, and
                            exit non-zero if it does not match.
  ${c_bold}ress scan${c_reset} [--json]        Look through the vault for anything shaped
                            like a credential.
  ${c_bold}ress enable-units${c_reset} [--all|--list] [UNIT...]
                            Turn on the user services a backup recorded,
                            after reading what each one runs.

  ${c_bold}ress status${c_reset} [--json]      What is captured, and when.
  ${c_bold}ress diff${c_reset} [--stock]       What changed since the last backup, or how
                            far this machine is from a stock Omarchy install.
  ${c_bold}ress init${c_reset} [--remote URL]  Create the vault.
  ${c_bold}ress set${c_reset} KEY=VALUE        Change a setting.
  ${c_bold}ress secrets${c_reset} <init|list|add|enable|disable>
  ${c_bold}ress doctor${c_reset}               Check this machine is ready.
  ${c_bold}ress link${c_reset}                 Put \`ress\` on your PATH (~/.local/bin).

Loadout links are ress.sh/gh/<user>/<repo>, which is a redirect to GitHub and
nothing else — resolved on this machine, before any request is made. Plain
GitHub URLs work everywhere a ress.sh link does.

Categories: ${CATEGORIES[*]}
Config:     $CONFIG_FILE
Settings:   AUR=${CFG[AUR]} ENABLE_UNITS=${CFG[ENABLE_UNITS]} SECRET_SCAN=${CFG[SECRET_SCAN]}
            CAPTURE_AUTOSTART=${CFG[CAPTURE_AUTOSTART]}   (change with \`ress set KEY=VALUE\`)
USAGE
}

# ================================================================= DISPATCH

VAULT_OVERRIDE=""
ARGS=()
while (( $# > 0 )); do
  case "$1" in
    --vault) VAULT_OVERRIDE="${2:-}"; shift 2 ;;
    --porcelain) PORCELAIN=1; shift ;;
    --dry-run|-n) DRY_RUN=1; shift ;;
    --yes|-y) ASSUME_YES=1; shift ;;
    --allow-unpinned) ALLOW_UNPINNED=1; shift ;;
    --aur) AUR_CHOICE="yes"; shift ;;
    --no-aur) AUR_CHOICE="no"; shift ;;
    --review-aur) AUR_CHOICE="yes"; AUR_REVIEW=1; shift ;;
    --version) printf '%s\n' "$VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; while (( $# > 0 )); do ARGS+=("$1"); shift; done ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

load_config
set -- "${ARGS[@]:-}"
command="${1:-status}"
shift || true

case "$command" in
  backup)  cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  share)   cmd_share "$@" ;;
  apply)   cmd_apply "$@" ;;
  loadout) cmd_loadout "$@" ;;
  resource) cmd_resource "$@" ;;
  status)  cmd_status "$@" ;;
  diff)    cmd_diff "$@" ;;
  init)    cmd_init "$@" ;;
  set)     cmd_set "$@" ;;
  secrets) cmd_secrets "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  link)    cmd_link "$@" ;;
  enable-units) cmd_enable_units "$@" ;;
  scan)    cmd_scan "$@" ;;
  verify)  cmd_verify "$@" ;;
  ""|help) usage ;;
  *)       die "unknown command: $command (try --help)" ;;
esac
